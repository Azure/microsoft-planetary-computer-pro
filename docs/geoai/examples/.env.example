# Optional: Storage account key (alternative to Azure AD auth)
# If not set, SDK will use DefaultAzureCredential with Azure RBAC roles
# STORAGE_ACCOUNT_KEY=your-storage-account-key-here

# Optional: Model API keys (alternative to Azure AD auth)
# If not set, SDK will use DefaultAzureCredential
# EOOS_API_KEY=your-eoos-api-key-here
# MARS_API_KEY=your-mars-api-key-here

# Optional: Override default log level (INFO)
# Optional: Enable DEBUG logging for troubleshooting
# Options: DEBUG, INFO, WARNING, ERROR
# GEOAI_LOG_LEVEL=INFO
